# Application
APP_NAME=haystack-fast-api
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (Postgres-Haystack host `postgres-haystack`, DB `heavy_rental` by default)
POSTGRES_HOSTNAME=postgres-haystack
POSTGRES_PORT=5432
POSTGRES_DB=heavy_rental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional full SQLAlchemy URL override (wins over discrete POSTGRES_* fields)
# Sync (current app default):  postgresql+psycopg://...
# Async (create_async_engine): postgresql+asyncpg://...
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres-haystack:5432/heavy_rental
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-haystack:5432/heavy_rental

# ---------------------------------------------------------------------------
# Need decomposer (FR-010.2) — free-text/file → internal equipment needs
# ---------------------------------------------------------------------------
# stub = deterministic local path (default; CI-safe, no network)
# llm  = OpenAI-compatible chat completions (e.g. DigitalOcean Inference Router)
NEED_DECOMPOSER=stub

# DigitalOcean Inference / Inference Router (OpenAI-compatible)
# Docs: https://docs.digitalocean.com/products/inference/
# Base URL for chat completions: https://inference.do-ai.run/v1
LLM_BASE_URL=https://inference.do-ai.run/v1
# DigitalOcean API token (or inference API key). Never commit real secrets.
# LLM_API_KEY=
# Model slug OR Inference Router id:
#   LLM_MODEL=router:your-router-name
#   LLM_MODEL=<direct-model-slug>   # see DO supported models list
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.5


# ---------------------------------------------------------------------------
# Indexing pipeline (HR-74) — FileTypeRouter dual-branch → embed → DocumentStore
# ---------------------------------------------------------------------------
# Embedder: mock (default, CI-safe) | openai | sentence-transformers
INDEXING_EMBEDDER=mock
# Vector width for every INDEXING_EMBEDDER mode (mock / openai / ST) and
# the pgvector column. Requested from OpenAI-compatible hosts when allowed;
# longer host vectors are truncated to N. Process env overrides this file.
# Changing N after table create requires DROP.
INDEXING_EMBEDDING_DIM=384
INDEXING_SPLIT_LENGTH=200
INDEXING_SPLIT_OVERLAP=20
# Used when INDEXING_EMBEDDER=openai (reuses LLM_API_KEY / LLM_BASE_URL when set)
INDEXING_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Used when INDEXING_EMBEDDER=sentence-transformers (requires ST stack installed)
INDEXING_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# DocumentStore backend (Phase 5 / I0 factory + I1 pipeline wire):
# memory (default, CI-safe; fresh InMemory store per ingest)
# pgvector (shared table indexing_project_chunks; requires DATABASE_URL/POSTGRES_*
#           + pgvector extension; retrieval filters user_id + ingest_id)
INDEXING_DOCUMENT_STORE=memory
# Optional TTL (seconds) stamped as meta.expires_at on project chunks (0 = off).
# Pair with purge_expired_chunks / discard_project_knowledge_session helpers.
INDEXING_CHUNK_TTL_SECONDS=0

# ---------------------------------------------------------------------------
# Call 1 ingest idempotency (S2a / resilience C1) — process-local only
# ---------------------------------------------------------------------------
# TTL (seconds) for cached successful lean responses under Idempotency-Key.
# Default 24h. Set to 0 or negative to disable expiry (still single-process).
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Phase 3 / S3 — Coordinator gate [4] (agent-fronted indexing)
# ---------------------------------------------------------------------------
# false (default) = as-built direct IndexingIngestService path
# true  = forced non-LLM LangGraph START→index_gate→END via
#         run_indexing_from_request (same lean DTO + KG hard-fail)
INDEXING_VIA_AGENT_GATE=false

# ---------------------------------------------------------------------------
# Phase 4 / S4 — fleet LTM for recommend tools
# ---------------------------------------------------------------------------
# fake (default, CI) = seed / injected DTOs
# sql = LiveSqlFleetBackend + Call 2 MVP read assets/bookings from the
#       assets table (equipment.id = assets.id). No seed fallback.
FLEET_BACKEND=sql
# Fleet + pricing SQL schema: primary_snapshot (default) | public
PRICING_SCHEMA=primary_snapshot

# ---------------------------------------------------------------------------
# Phase 8 / S8.3 — live Neo4j / KG-2 tools
# ---------------------------------------------------------------------------
# fake (default, CI) = FakeNeo4jBackend (empty unless injected)
# bolt = live Bolt client (fleet labels only; never :Document)
NEO4J_BACKEND=fake
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_POPULATE_URL=http://neo4j-populate:8089/v1/populate
NEO4J_POPULATE_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------------------
# Phase 7 / S7.5 — Call 2 multi-agent enrich
# ---------------------------------------------------------------------------
# false (default) = SessionRecommendService → RecommendationService MVP
# true  = run_recommend_graph → same quote DTO (quoteRef / items[])
#         Gate refuse (session meta.indexing_ok=false) → 400
RECOMMEND_VIA_AGENT_GRAPH=false

# ---------------------------------------------------------------------------
# Knowledge graph (HR-76) — mandatory after final_doc_joiner
# ---------------------------------------------------------------------------
# Always built on successful index; failure fails the ingest request.
# Artifacts: {KG_ARTIFACT_DIR}/{user_id}/kg_{ingest_id}.json
KG_ARTIFACT_DIR=artifacts/kg
# false = document nodes only (CI-safe); true = full Ragas transforms (LLM cost)
# Full transforms run only inside KnowledgeGraphGenerator when true.
KG_APPLY_TRANSFORMS=false

# Dynamic-pricing monthly retrain scheduler (default disabled)
PRICING_RETRAIN_ENABLED=false
PRICING_RETRAIN_INTERVAL_DAYS=30
PRICING_RETRAIN_MISFIRE_GRACE_SECONDS=21600
PRICING_RETRAIN_MIN_REAL_ROWS_PER_CATEGORY=125
PRICING_RETRAIN_REAL_SAMPLE_WEIGHT=10.0

