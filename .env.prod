# Sample production profile for Heavy-Rental/haystack-fast-api
# Copy to the app repo as `.env.prod` (or `docs/samples/.env.prod`).
#
# This is NOT a Spring-style profile file. pydantic Settings loads `.env`
# (app/config.py). Release Packaging sanitizes this file, drops estate keys,
# and COPY's it to /app/.env so the image has product defaults.
#
# Process env still wins (Academy compose env_file from Secrets Manager +
# Haystack Environment academy overlay, or docker run -e).
#
# Do NOT:
#   - COPY this file yourself in an app Dockerfile (Release generates the image)
#   - Put RDS hosts, Bolt NLB, or passwords here
#   - Set NEO4J_URI=bolt://neo4j:7687 (compose lab hostname; AWS uses the NLB)
#   - Commit LLM_API_KEY or database passwords
#
# Ownership (ADR 0008 / 0009):
#   Infra sync-secrets → heavy-rental/haystack → guest .env
#   Haystack Environment academy → CD overlay (non-empty only)
#   This file → image /app/.env product defaults

# ---------------------------------------------------------------------------
# Application (image + optional academy overlay)
# ---------------------------------------------------------------------------
APP_NAME=haystack-fast-api
APP_ENV=prod
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Estate — infra sync-secrets only. Leave unset here.
# Haystack RDS database name is `haystack` (not the example `heavy_rental`).
# DATABASE_URL from SM wins; pydantic rewrites postgresql:// → postgresql+psycopg://.
# ---------------------------------------------------------------------------
# POSTGRES_HOSTNAME=
# POSTGRES_PORT=5432
# POSTGRES_DB=haystack
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# DATABASE_URL=
# SOURCE_HOST=
# SOURCE_PORT=5432
# SOURCE_DATABASE=heavy_rental
# TARGET_HOST=
# TARGET_PORT=5432
# TARGET_DATABASE=haystack

# ---------------------------------------------------------------------------
# Need decomposer
# stub = no LLM (safe default). llm = OpenAI-compatible (needs LLM_API_KEY).
# LLM_API_KEY: infra SM optional or academy Environment secret — never here.
# ---------------------------------------------------------------------------
NEED_DECOMPOSER=llm
LLM_BASE_URL=https://inference.do-ai.run/v1
# LLM_API_KEY=
LLM_MODEL=router:heavy-rental
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.5

# ---------------------------------------------------------------------------
# Indexing (HR-74)
# Safe academy default: mock + memory.
# Live: INDEXING_EMBEDDER=openai (reuses LLM_*) or sentence-transformers,
#       INDEXING_DOCUMENT_STORE=pgvector after CREATE EXTENSION vector on
#       Haystack RDS and a matching INDEXING_EMBEDDING_DIM. Set those on
#       Environment academy; do not put them in infra sync-secrets.
# ---------------------------------------------------------------------------
INDEXING_EMBEDDER=openai
INDEXING_EMBEDDING_DIM=1024
INDEXING_SPLIT_LENGTH=200
INDEXING_SPLIT_OVERLAP=20
INDEXING_OPENAI_EMBEDDING_MODEL=qwen3-embedding-0.6b
#INDEXING_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEXING_DOCUMENT_STORE=memory
INDEXING_CHUNK_TTL_SECONDS=0

# ---------------------------------------------------------------------------
# Call 1 idempotency + coordinator gate
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400
INDEXING_VIA_AGENT_GATE=true

# ---------------------------------------------------------------------------
# Fleet / pricing (live flags). Infra SM writes these if missing; overlay may override.
# ---------------------------------------------------------------------------
FLEET_BACKEND=sql
PRICING_SCHEMA=primary_snapshot
# PRICING_SCHEMA=public

# ---------------------------------------------------------------------------
# Neo4j / KG-2
# NEO4J_BACKEND=bolt is the live flag (infra SM).
# NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD come from Terraform Bolt NLB via SM.
# NEO4J_POPULATE_URL is http://neo4j-populate:8089/v1/populate (compose worker
# on asg-haystack, not an ALB).
# ---------------------------------------------------------------------------
NEO4J_BACKEND=bolt
NEO4J_POPULATE_TIMEOUT_SECONDS=2
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=
# NEO4J_POPULATE_URL=

# ---------------------------------------------------------------------------
# Recommend graph + knowledge graph + project agent
# ---------------------------------------------------------------------------
RECOMMEND_VIA_AGENT_GRAPH=true
RECOMMEND_FANOUT_CAP=4
KG_ARTIFACT_DIR=artifacts/kg
KG_APPLY_TRANSFORMS=false
PROJECT_AGENT_MODE=llm
PROJECT_AGENT_TOP_K=5
