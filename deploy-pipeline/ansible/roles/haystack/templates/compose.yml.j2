services:
  haystack:
    image: {{ haystack_image }}
    ports:
      - "8000:8000"
    env_file:
      - .env
    mem_limit: 768m
    cpus: "1.0"
    restart: unless-stopped

  # Devcontainer workers (not python -m in the uvicorn image).
  # Scripts: {{ compose_dir }}/workers/ (Ansible copy).
  postgres-haystack-sync:
    image: postgres:17
    env_file:
      - .env
    volumes:
      - {{ compose_dir }}/workers/sync-from-primary.sh:/usr/local/bin/sync-from-primary.sh:ro
    entrypoint: ["/bin/bash", "/usr/local/bin/sync-from-primary.sh"]
    mem_limit: 256m
    cpus: "0.25"
    restart: unless-stopped

  neo4j-populate:
    image: python:3.12-slim
    env_file:
      - .env
    volumes:
      - {{ compose_dir }}/workers/populate_neo4j.py:/usr/local/bin/populate_neo4j.py:ro
      - {{ compose_dir }}/workers/populate-neo4j-from-haystack.sh:/usr/local/bin/populate-neo4j-from-haystack.sh:ro
    entrypoint: ["/bin/bash", "-c"]
    command:
      - pip install --no-cache-dir 'psycopg[binary]==3.2.9' 'neo4j==5.28.1' && exec bash /usr/local/bin/populate-neo4j-from-haystack.sh
    mem_limit: 256m
    cpus: "0.25"
    restart: unless-stopped
