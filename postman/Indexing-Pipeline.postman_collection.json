      "item": [
        {
          "name": "01 GET Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body has status field', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('status');",
                  "    pm.expect(['ok', 'degraded']).to.include(j.status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Sanity check. `status` may be `degraded` if Postgres is down; indexing still works."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Happy path — JSON (unstructured)",
      "item": [
        {
          "name": "02 POST JSON project_text (unstructured)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.test('ingest_id prefix', function () {",
                  "    pm.expect(j.ingest_id).to.match(/^ing_/);",
                  "});",
                  "pm.test('data_kind unstructured', function () {",
                  "    pm.expect(j.data_kind).to.eql('unstructured');",
                  "});",
                  "pm.test('wrote embedded chunks', function () {",
                  "    pm.expect(j.document_count).to.be.at.least(1);",
                  "    pm.expect(j.chunk_count).to.be.at.least(1);",
                  "    pm.expect(j.documents_written).to.be.at.least(1);",
                  "    pm.expect(j.documents).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(j.documents[0].has_embedding).to.eql(true);",
                  "    pm.expect(j.documents[0].content_preview.length).to.be.at.least(1);",
                  "});",
                  "pm.test('no legacy recommend envelope', function () {",
                  "    pm.expect(j).to.not.have.property('recommendation_id');",
                  "    pm.expect(j).to.not.have.property('results_by_need');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_text\": \"Indoor elevated work ~8m for scissors lift\",\n  \"start_date\": \"2026-09-01\",\n  \"end_date\": \"2026-09-12\",\n  \"options\": {\n    \"include_pricing\": true\n  }\n}\n"
            },
            "url": "{{baseUrl}}{{ingestPath}}",
            "description": "JSON free-text is treated as unstructured `text/plain`.\n\nExpect: `data_kind=unstructured`, `documents_written >= 1`, `has_embedding=true`."
